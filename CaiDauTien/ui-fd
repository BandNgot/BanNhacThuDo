function FeedbackWidget:Mount(parent)
    local env = getGlobalEnv()
    local prevGlobal = env.__DacCauFeedbackWidgetActive
    if prevGlobal and prevGlobal ~= self and type(prevGlobal) == "table" and type(prevGlobal.Destroy) == "function" then
        pcall(function() prevGlobal:Destroy() end)
    end
    if FeedbackWidget._activeInstance and FeedbackWidget._activeInstance ~= self then FeedbackWidget._activeInstance:Destroy() end
    FeedbackWidget._activeInstance = self
    env.__DacCauFeedbackWidgetActive = self
    if self.state.mounted and self._ui and self._ui.screenGui and self._ui.screenGui.Parent then return self end

    cleanupOrphanedEffects()
    local targetParent = getUiParent(parent)
    for _, obj in ipairs(targetParent:GetChildren()) do if obj.Name == self.config.guiName and obj:IsA("ScreenGui") then obj:Destroy() end end

    local theme = self.theme
    local screenGui = create("ScreenGui", {Name = self.config.guiName, ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100}, targetParent)
    self._ui, self._reactiveSheens, self._ignoreGuiInset = {screenGui = screenGui}, {}, screenGui.IgnoreGuiInset
    local layout = self:_collapsedLayout("feedback", false)

    local function makeIslandShell(name, slot, icon, title, subtitle, fullVisible)
        local shadow, shadowImg = buildOuterShadow(screenGui, 10, false)
        shadow.Position, shadow.Size, shadow.Visible = slot.position, slot.size, false
        local panel = create("Frame", {Name = name, ClipsDescendants = true, AnchorPoint = Vector2.new(0.5, 0), Position = slot.position, Size = slot.size, ZIndex = 12}, screenGui)
        applyLiquidGlass(self, panel, {isIsland = true, radius = UDim.new(1, 0)})
        local btn = create("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", AutoButtonColor = false, ZIndex = 15}, panel)
        local full = create("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = fullVisible, ZIndex = 15}, btn)
        local orb = create("Frame", {BackgroundColor3 = theme.accent, BackgroundTransparency = 0.14, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0), Size = UDim2.fromOffset(26, 26), ZIndex = 16}, full)
        addCorner(orb, UDim.new(1, 0))
        create("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Image = icon, ImageColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 17}, orb)
        local titleLbl = makeLabel(full, title, FONT_BOLD, 12, theme.islandText, UDim2.fromOffset(40, 5), UDim2.new(1, -68, 0, 16), 16)
        local subLbl = makeLabel(full, subtitle, FONT_BODY, 10, theme.islandDim, UDim2.fromOffset(40, 20), UDim2.new(1, -68, 0, 14), 16)
        local dot = create("Frame", {BackgroundColor3 = theme.ok, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -11, 0.5, 0), Size = UDim2.fromOffset(7, 7), ZIndex = 16}, full)
        addCorner(dot, UDim.new(1, 0))
        local iconOnly = create("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 18), Image = icon, ImageColor3 = theme.islandText, Visible = not fullVisible, ZIndex = 16}, btn)
        return panel, shadow, shadowImg, btn, full, iconOnly, titleLbl, subLbl, dot
    end

    local panel, panelShadow, panelShadowImg, collapsedFeedback, fbFull, fbIconOnly = makeIslandShell("FeedbackIsland", layout.feedback, self.config.feedbackIcon, self.config.buttonLabel, "Gop y nhanh", true)
    local musicPanel, musicShadow, musicShadowImg, collapsedMusic, muFull, muIconOnly, muTitle, muStatus, muStatusDot = makeIslandShell("MusicIsland", layout.music, self.config.musicIcon, self.config.musicLabel, self.config.musicStatus, false)

    local eqHolder = create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -11, 0.5, 0), Size = UDim2.fromOffset(14, 14), ZIndex = 16}, muFull)
    local eqBars = {}
    for i = 1, 3 do
        local bar = create("Frame", {BackgroundColor3 = theme.accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, (i - 1) * 4, 1, -1), Size = UDim2.fromOffset(2, 4), Visible = false, ZIndex = 17}, eqHolder)
        addCorner(bar, UDim.new(1, 0)); table.insert(eqBars, bar)
    end

    local peekTab = create("TextButton", {Name = "PeekTab", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -36), Size = UDim2.fromOffset(64, 20), Text = "", AutoButtonColor = false, Visible = false, ZIndex = 18}, screenGui)
    applyLiquidGlass(self, peekTab, {isIsland = true, radius = UDim.new(1, 0)}); makeChevronDownIcon(peekTab, theme.islandText, 20)

    local toast = create("Frame", {Name = "LiquidGlassToast", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, self:_getSafeTopBase() + 10), Size = UDim2.fromOffset(288, 36), Visible = false, ZIndex = 30}, screenGui)
    local toastGlass = applyLiquidGlass(self, toast, {isIsland = true, radius = UDim.new(1, 0)})
    local toastDot = create("Frame", {BackgroundColor3 = theme.ok, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(8, 8), ZIndex = 32}, toast)
    addCorner(toastDot, UDim.new(1, 0))
    local toastText = makeLabel(toast, "", FONT_MEDIUM, 12, theme.islandText, UDim2.fromOffset(28, 0), UDim2.new(1, -40, 1, 0), 32)

    self._ui.panel, self._ui.panelShadow, self._ui.panelShadowImg = panel, panelShadow, panelShadowImg
    self._ui.musicPanel, self._ui.musicShadow, self._ui.musicShadowImg = musicPanel, musicShadow, musicShadowImg
    self._ui.collapsedFeedback, self._ui.collapsedFeedbackFull, self._ui.collapsedFeedbackIconOnly = collapsedFeedback, fbFull, fbIconOnly
    self._ui.collapsedMusic, self._ui.collapsedMusicFull, self._ui.collapsedMusicIconOnly = collapsedMusic, muFull, muIconOnly
    self._ui.musicTitle, self._ui.musicStatus, self._ui.musicStatusDot, self._ui.eqBars = muTitle, muStatus, muStatusDot, eqBars
    self._ui.peekTab, self._ui.toast, self._ui.toastDot, self._ui.toastText, self._ui.toastStroke = peekTab, toast, toastDot, toastText, toastGlass.outerStroke

    self:_ensurePanelLensRig(panel); self:_ensurePanelLensRig(musicPanel)
    self:_buildFeedbackBody(panel, theme); self:_buildMusicBody(musicPanel, theme)

    self:_trackConnection(collapsedFeedback.MouseButton1Click:Connect(function()
        if self.state.hidden then self:_markIslandActivity() return end
        if self.state.activeIsland ~= "feedback" then self:_switchIsland("feedback") else self:_togglePanel(true) end
    end))
    self:_trackConnection(collapsedMusic.MouseButton1Click:Connect(function()
        if self.state.hidden then self:_markIslandActivity() return end
        if self.state.activeIsland ~= "music" then self:_switchIsland("music") else self:_toggleMusicPanel(true) end
    end))
    for _, btn in ipairs({collapsedFeedback, collapsedMusic, peekTab}) do
        self:_trackConnection(btn.MouseEnter:Connect(function() self._islandHovering = true; self:_markIslandActivity() end))
        self:_trackConnection(btn.MouseLeave:Connect(function() self._islandHovering = false; self:_scheduleAutoHide() end))
    end
    self:_trackConnection(peekTab.MouseButton1Click:Connect(function() self:_markIslandActivity() end))

    self:_trackConnection(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if self._draggingSheet and self.state.open and self._dragPanel then
                local delta = Vector2.new(input.Position.X, input.Position.Y) - self._dragStartInput
                local screen, pSize = self:_getScreenSize(), self._dragPanel.AbsoluteSize
                local minX, maxX = pSize.X * 0.5 + 8, math.max(pSize.X * 0.5 + 8, screen.X - pSize.X * 0.5 - 8)
                local minY, maxY = self:_getSafeTopBase() + 6, math.max(self:_getSafeTopBase() + 6, screen.Y - pSize.Y - 8)
                local nx = math.clamp(self._dragStartPos.X + delta.X, minX, maxX)
                local ny = math.clamp(self._dragStartPos.Y + delta.Y, minY, maxY)
                self._sheetCustomPos = Vector2.new(nx, ny)
                local newPos = UDim2.fromOffset(nx, ny)
                self._dragPanel.Position = newPos
                if self._dragShadow then self._dragShadow.Position = newPos end
            end
            if self._seekingProgress then self:_seekMusicAtScreenX(input.Position.X) end
            if self._draggingVolume and self._ui.volumeTrack and self._ui.volumeTrack.AbsoluteSize.X > 0 then
                local vt = self._ui.volumeTrack
                self:_setMusicVolume((input.Position.X - vt.AbsolutePosition.X) / vt.AbsoluteSize.X, true)
            end
            if self.state.hidden and not self.state.open and self:_isPointerNearIsland() then self:_markIslandActivity() end
            self:_updateReactiveSheens(UserInputService:GetMouseLocation())
        end
    end))
    self:_trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self._seekingProgress, self._draggingVolume, self._draggingSheet = false, false, false
        end
    end))
    self:_trackConnection(screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if not self.state.mounted then return end
        if self.state.open then
            local isMusic = self.state.activeIsland == "music"
            local size, pos = self:_getSheetBounds(isMusic)
            local target, shadow = isMusic and musicPanel or panel, isMusic and musicShadow or panelShadow
            target.Size, target.Position = size, pos; self:_syncShadow(shadow, pos, size, true)
        else self:_applyCollapsedLayout(false, self.state.activeIsland) end
    end))
    self:_trackConnection(RunService.RenderStepped:Connect(function()
        if not self.state.mounted then return end
        if not self._ui or not self._ui.screenGui or not self._ui.screenGui.Parent then
            self:Destroy()
            return
        end
        if self.state.open then self:_updateAcrylic(); self:_updateBackdropLens() else self:_hideAcrylic() end
        local playing = self.music and self.music.playing
        if playing then self:_updateMusicProgress() end
        if self._ui.eqBars and self._ui.musicStatusDot then
            local showEq = playing and not self.state.open and self.state.activeIsland == "music"
            self._ui.musicStatusDot.Visible = not showEq
            local t = os.clock() * 7.5
            for i, bar in ipairs(self._ui.eqBars) do
                bar.Visible = showEq
                if showEq then bar.Size = UDim2.fromOffset(2, 4 + math.floor((math.sin(t + i * 1.45) * 0.5 + 0.5) * 9)) end
            end
        end
    end))

    self.state.mounted = true
    self:_loadMusicStorage(); self:_syncMusicFavoriteMap()
    self.music.index = math.max(1, tonumber(self.music.index) or 1)
    self:_applySoundVolume(); self:_renderMusicCollection("playlist", nil, true)
    self:_loadMusicTrack(self.music.index, self.config.musicAutoPlay)
    self:_refreshMetaPreview(); self:_setTab(self.state.activeTab, true)
    self:_applyCollapsedLayout(false, "feedback"); self:_scheduleAutoHide()
    return self
end

function FeedbackWidget:Destroy()
    self.state.mounted, self.state.open, self.state.hidden = false, false, false
    self._islandHovering, self._seekingProgress, self._draggingVolume, self._draggingSheet = false, false, false, false
    self._sheetCustomPos, self._dragPanel, self._dragShadow = nil, nil, nil
    self._animToken, self._toastToken, self._hideToken = self._animToken + 1, self._toastToken + 1, self._hideToken + 1
    self._submitToken, self._musicSearchToken, self._musicLoadToken = self._submitToken + 1, self._musicSearchToken + 1, self._musicLoadToken + 1
    self:_cancelTweens()
    for _, conn in ipairs(self._connections or {}) do pcall(function() conn:Disconnect() end) end
    self._connections = {}
    self:_destroyAcrylic()
    self:_clearBackdropLens()
    self._lensRigs = {}
    if self._worldBlur then pcall(function() self._worldBlur:Destroy() end); self._worldBlur = nil end
    if self.music then
        self.music.playing, self.music.paused, self.music.loadedSoundId = false, false, nil
        if self.music.sound then pcall(function() self.music.sound:Stop(); self.music.sound:Destroy() end); self.music.sound = nil end
    end
    if self._ui and self._ui.screenGui then pcall(function() self._ui.screenGui:Destroy() end) end
    self._ui, self._reactiveSheens, self._glass = {}, {}, {}
    if FeedbackWidget._activeInstance == self then FeedbackWidget._activeInstance = nil end
    local env = getGlobalEnv()
    if env.__DacCauFeedbackWidgetActive == self then env.__DacCauFeedbackWidgetActive = nil end
end

return FeedbackWidget
