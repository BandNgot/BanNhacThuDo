        self._ui.musicFavoriteButton.BackgroundTransparency = fav and 0.16 or theme.pillTransparency
    end
    if self._ui.musicFavoriteIcon then self._ui.musicFavoriteIcon.ImageColor3 = fav and theme.heart or theme.textDim end
    if self._ui.musicRepeatButton then
