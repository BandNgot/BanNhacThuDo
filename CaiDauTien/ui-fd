function FeedbackWidget:_submit()
    if self.state.sending then return end
    local url = trimString(self.config.webhookUrl)
    if url == "" or url == "PASTE_DISCORD_WEBHOOK_URL_HERE" then
        self:_setStatus("Chua cau hinh webhookUrl", "err"); self:_showToast("Thieu webhookUrl trong config", "err"); return
    end
    local tab = self.state.activeTab
    local title, message = trimString(self._ui.titleBox and self._ui.titleBox.Text or ""), trimString(self._ui.messageBox and self._ui.messageBox.Text or "")
    if message == "" then
        self:_setStatus("Vui long nhap noi dung gop y", "err"); self:_showToast("Noi dung khong duoc de trong", "err"); return
    end
    self.state.fields[tab] = {title = title, message = message}
    self:_setSendingState(true); self:_setStatus("Dang gui phan hoi...", "info")
    self._submitToken = (self._submitToken or 0) + 1
    local submitToken, payload = self._submitToken, self:_buildWebhookPayload(tab, title, message)

    task.spawn(function()
        local result = WebhookClient.new(url):send(payload)
        if not self.state.mounted or submitToken ~= self._submitToken then return end
        self:_setSendingState(false)
        if result.ok then
            self.state.fields[tab] = {title = "", message = ""}
            if self.state.activeTab == tab then
                if self._ui.titleBox then self._ui.titleBox.Text = "" end
                if self._ui.messageBox then self._ui.messageBox.Text = "" end
            end
            self:_setStatus("Da gui thanh cong! Cam on ban.", "ok"); self:_showToast("Da gui gop y thanh cong", "ok")
            if self.config.autoCollapseOnSuccess then
                task.delay(self.config.successCollapseDelay, function()
                    if submitToken == self._submitToken and self.state.mounted and self.state.open and self.state.activeIsland == "feedback" then self:_togglePanel(false) end
                end)
            end
        else
            local err = tostring(result.error or "Gui that bai")
            self:_setStatus("Loi gui: " .. shortenText(err, 72), "err"); self:_showToast("Loi: " .. shortenText(err, 48), "err")
        end
    end)
end

-- Music Engine, Persistence, Search & Playback -------------------------------

function FeedbackWidget:_normalizeMusicItem(track, index)
    if type(track) == "string" or type(track) == "number" then
        local sid = normalizeSoundId(track)
        return sid and {title = "Track " .. tostring(index or 1), artist = "Roblox audio", soundId = sid, cover = self.config.musicIcon} or nil
    end
    if type(track) ~= "table" then return nil end
    local sid = normalizeSoundId(track.soundId or track.assetId or track.id)
    if not sid then return nil end
    return {
        title = tostring(track.title or track.name or ("Track " .. tostring(index or 1))),
        artist = tostring(track.artist or track.subtitle or track.author or "Dac Cau"),
        soundId = sid, cover = normalizeSoundId(track.cover or track.coverIcon) or self.config.musicIcon
    }
end

function FeedbackWidget:_musicTrackKey(track)
    if type(track) ~= "table" then return nil end
    local sid = normalizeSoundId(track.soundId or track.assetId or track.id)
    return extractAssetId(sid) or sid
end

function FeedbackWidget:_getMusicTrack(index)
    local pl = self.music and self.music.playlist or {}
    if type(pl) ~= "table" or #pl == 0 then return nil end
    local idx = index or self.music.index
    return self:_normalizeMusicItem(pl[idx], idx)
end

function FeedbackWidget:_syncMusicFavoriteMap()
    self.music.favorites = type(self.music.favorites) == "table" and self.music.favorites or {}
    self.music.favoriteMap = {}
    local cleaned = {}
    for i, item in ipairs(self.music.favorites) do
        local track = self:_normalizeMusicItem(item, i)
        local key = self:_musicTrackKey(track)
        if track and key and not self.music.favoriteMap[key] then self.music.favoriteMap[key] = true; table.insert(cleaned, track) end
    end
    self.music.favorites = cleaned
end

function FeedbackWidget:_loadMusicStorage()
    if not self.config.persistMusicFavorites then return false end
    local data, err = readJsonFile(self.config.musicStorageFile)
    if type(data) ~= "table" then self.music.storageLoaded, self.music.storageError = false, err; return false end
    local saved = data.musicFavorites or data.favorites or data.savedMusic
    if type(saved) == "table" then
        local replaced = {}
        for _, item in ipairs(saved) do table.insert(replaced, item) end
        self.music.favorites = replaced
    end
    self.music.storageLoaded, self.music.storageError = true, nil
    self:_syncMusicFavoriteMap()
    return true
end

function FeedbackWidget:_saveMusicStorage()
    if not self.config.persistMusicFavorites then return false, "disabled" end
    self:_syncMusicFavoriteMap()
    local ok, err = writeJsonFile(self.config.musicStorageFile, {version = 1, musicFavorites = self.music.favorites or {}})
    self.music.storageError = err
    return ok, err
end

function FeedbackWidget:_isMusicFavorite(track)
    local key = self:_musicTrackKey(track)
    return key ~= nil and self.music.favoriteMap and self.music.favoriteMap[key] == true
end

function FeedbackWidget:_ensureMusicSound()
    local sound = self.music.sound
    if sound and sound.Parent then return sound end
    sound = create("Sound", {Name = "DacCauMusicPlayer", Volume = self.music.muted and 0 or self.music.volume, Looped = false}, SoundService)
    self.music.sound = sound
    self:_trackConnection(sound.Ended:Connect(function()
        if not self.state.mounted or not self.music or not self.music.playing then return end
        if self.music.repeatOne then self:_loadMusicTrack(self.music.index or 1, true) else self:_nextMusicTrack(true) end
    end))
    return sound
end

function FeedbackWidget:_setMusicUiStatus(text, holdSeconds)
    self.music.status = text or "San sang"
    self._musicStatusHoldUntil = (holdSeconds and holdSeconds > 0) and (os.clock() + holdSeconds) or 0
    if self._ui.musicStatus then self._ui.musicStatus.Text = self.music.status end
