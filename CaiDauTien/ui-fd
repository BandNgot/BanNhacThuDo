function FeedbackWidget:_positionSegmentIndicator(indicator, items, activeIndex, animate)
    if not indicator or not items or #items == 0 then return end
    local count, idx = #items, math.clamp(activeIndex or 1, 1, #items)
    local sz, pos = UDim2.new(1 / count, -4, 1, -4), UDim2.new((idx - 1) / count, 2, 0, 2)
    if animate then self:_trackTween("segment", indicator, 0.26, {Size = sz, Position = pos})
    else indicator.Size, indicator.Position = sz, pos end
end

function FeedbackWidget:_setTab(tabKey, instant)
    if not TAB_CONFIG[tabKey] then return end
    local cur = self.state.activeTab
    if self._ui.titleBox and self._ui.messageBox and self.state.fields[cur] then
        self.state.fields[cur].title, self.state.fields[cur].message = self._ui.titleBox.Text, self._ui.messageBox.Text
    end
    self.state.activeTab = tabKey
    local cfg, draft = TAB_CONFIG[tabKey], self.state.fields[tabKey] or {title = "", message = ""}
    if self._ui.titleBox then self._ui.titleBox.PlaceholderText, self._ui.titleBox.Text = cfg.hintTitle, draft.title or "" end
    if self._ui.messageBox then self._ui.messageBox.PlaceholderText, self._ui.messageBox.Text = cfg.hintBody, draft.message or "" end
    local activeIdx = 1
    for i, key in ipairs(TAB_ORDER) do
        local btn, selected = self._ui.tabButtons and self._ui.tabButtons[key], key == tabKey
        if selected then activeIdx = i end
        if btn then btn.TextColor3 = selected and self.theme.text or self.theme.textDim; btn.Font = selected and FONT_BOLD or FONT_MEDIUM end
    end
    self:_positionSegmentIndicator(self._ui.feedbackTabIndicator, TAB_ORDER, activeIdx, not instant)
end

function FeedbackWidget:_setSendingState(sending)
