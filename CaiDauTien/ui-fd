local function create(className, props, parent)
    local obj = Instance.new(className)
    if props then for k, v in pairs(props) do obj[k] = v end end
    if parent then obj.Parent = parent end
    return obj
end

local function addCorner(p, r)
    return create("UICorner", {CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 18)}, p)
end

local function addStroke(p, c, t, th)
    return create("UIStroke", {ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = th or 1, Color = c, Transparency = t or 0.78}, p)
end

local function addPadding(p, t, r, b, l)
