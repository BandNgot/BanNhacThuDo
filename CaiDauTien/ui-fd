        self._ui.musicResultsScroll.Size = UDim2.new(1, 0, 1, mode == "search" and -76 or -38)
    end
end

function FeedbackWidget:_renderMusicCollection(mode, statusText, keepToken)
    if not keepToken then self._musicSearchToken = (self._musicSearchToken or 0) + 1 end
    self.music.viewMode = mode
    if mode == "favorites" then self:_syncMusicFavoriteMap() end
    self:_updateMusicViewTabs()
    local src = mode == "favorites" and (self.music.favorites or {}) or (self.music.masterPlaylist or {})
    local list = {}
    for i, item in ipairs(src) do local t = self:_normalizeMusicItem(item, i); if t then table.insert(list, t) end end
    self:_renderMusicList(list)
    local fallback = mode == "favorites" and (#list > 0 and ("Saved: " .. #list .. " bai") or "Chua co bai da luu") or (#list > 0 and ("Playlist: " .. #list .. " bai") or "Playlist trong")
    self:_setMusicUiStatus(statusText or fallback, statusText and 2 or 0)
end

function FeedbackWidget:_openMusicSearchTab()
    self.music.viewMode = "search"
    self:_updateMusicViewTabs()
    local q = trimString(self._ui.musicSearchBox and self._ui.musicSearchBox.Text or "")
    if q == "" then self:_renderMusicList({}); self:_setMusicUiStatus("Nhap ten bai hat hoac ID") else self:_runMusicSearch(q) end
end

function FeedbackWidget:_selectMusicResult(index)
    local chosen = self:_normalizeMusicItem((self.music.searchResults or {})[index], index)
    if not chosen or not chosen.soundId then return end
    if self.music.viewMode == "playlist" or self.music.viewMode == "favorites" then
        local src, queue = self.music.viewMode == "favorites" and (self.music.favorites or {}) or (self.music.masterPlaylist or {}), {}
        for i, item in ipairs(src) do local t = self:_normalizeMusicItem(item, i); if t then table.insert(queue, t) end end
        self.music.playlist, self.music.queueSource = queue, self.music.viewMode
        self:_loadMusicTrack(index, true)
    else
        local queue = self.music.playlist or {}
        if self.music.queueSource ~= "playlist" then
            queue = {}
            for i, item in ipairs(self.music.masterPlaylist or {}) do local t = self:_normalizeMusicItem(item, i); if t then table.insert(queue, t) end end
            self.music.playlist, self.music.queueSource = queue, "playlist"
        end
        local key, targetIdx = self:_musicTrackKey(chosen), nil
        for i, item in ipairs(queue) do if self:_musicTrackKey(item) == key then targetIdx = i break end end
        if not targetIdx then table.insert(queue, chosen); targetIdx = #queue end
        self:_loadMusicTrack(targetIdx, true)
    end
end

function FeedbackWidget:_parseMusicSearchResults(data)
    local results, seen = {}, {}
    local function push(item)
        if type(item) ~= "table" or #results >= self.config.musicSearchLimit then return end
        local asset = item.asset or item.Asset or item
        local id = extractAssetId(asset.id or asset.assetId or asset.AssetId or item.id or item.assetId or item.AssetId)
        if not id or seen[id] then return end
        seen[id] = true
        local creator = item.creator or asset.creator or item.Creator or asset.Creator
        local creatorName = type(creator) == "table" and (creator.name or creator.displayName or creator.Name or creator.DisplayName or "Creator Store") or (creator ~= nil and tostring(creator) or "Creator Store")
        local title = asset.name or asset.displayName or asset.title or item.name or item.displayName or item.title or ("Audio " .. id)
        table.insert(results, {title = tostring(title), artist = tostring(creatorName), soundId = "rbxassetid://" .. id, cover = self.config.musicIcon})
    end
    if type(data) == "table" then
        for _, key in ipairs({"data", "assets", "results", "creatorStoreAssets", "creatorStoreProducts", "items", "records"}) do
            if type(data[key]) == "table" then for _, item in ipairs(data[key]) do push(item) end end
        end
        if #results == 0 then
            for _, bucket in pairs(data) do
                if type(bucket) == "table" then for _, item in ipairs(bucket) do push(item) end; if #results > 0 then break end end
            end
        end
    end
    return results
end

function FeedbackWidget:_runMusicSearch(query, token)
    query = trimString(query)
    if token == nil then self._musicSearchToken = (self._musicSearchToken or 0) + 1; token = self._musicSearchToken end
    if query == "" then self:_renderMusicList({}); self:_setMusicUiStatus("Nhap ten hoac ID audio"); return end
    local directId = (query:match("^rbxassetid://%d+$") or query:match("^%d+$")) and extractAssetId(query) or nil
    if directId then
        self:_renderMusicList({{title = "Audio " .. directId, artist = "Direct asset", soundId = "rbxassetid://" .. directId, cover = self.config.musicIcon}})
        self:_setMusicUiStatus("Tim thay ID truc tiep"); return
    end
    if #query < 2 then self:_renderMusicList({}); self:_setMusicUiStatus("Nhap it nhat 2 ky tu hoac ID"); return end
    local cacheKey = query:lower()
    if self._musicSearchCache[cacheKey] then
        local cached = self._musicSearchCache[cacheKey]
        self:_renderMusicList(cached); self:_setMusicUiStatus(#cached > 0 and "Chon ket qua de phat" or "Khong co ket qua"); return
    end
    local req = getRequestFn()
    if not req then self:_renderMusicList({}); self:_setMusicUiStatus("Executor khong ho tro request"); return end
    self:_renderMusicList({}); self:_setMusicUiStatus("Dang tim tren Roblox...")

    task.spawn(function()
        local url = self.config.musicSearchEndpoint .. "?searchCategoryType=Audio&query=" .. urlEncode(query) .. "&maxPageSize=" .. tostring(self.config.musicSearchLimit) .. "&sortCategory=Relevance&searchView=Full"
        local ok, res = pcall(req, {Url = url, Method = "GET", Headers = {["Accept"] = "application/json"}})
        if token ~= self._musicSearchToken or not self.state.mounted or self.music.viewMode ~= "search" then return end
        if not ok or type(res) ~= "table" then self:_setMusicUiStatus("Loi request search"); return end
        local status = tonumber(res.StatusCode or res.Status or res.statusCode or res.status or 0) or 0
        local success = res.Success; if success == nil then success = res.success end; if success == nil then success = (status >= 200 and status < 300) end
        if status == 429 then self:_setMusicUiStatus("Qua nhieu yeu cau (429)"); return end
        if success ~= true then self:_setMusicUiStatus("Search loi " .. tostring(status)); return end
        local decOk, decoded = pcall(function() return HttpService:JSONDecode(tostring(res.Body or res.body or "")) end)
        if token ~= self._musicSearchToken or not self.state.mounted or self.music.viewMode ~= "search" then return end
        if not decOk or type(decoded) ~= "table" then self:_setMusicUiStatus("Khong doc duoc ket qua"); return end
        local results = self:_parseMusicSearchResults(decoded)
        self._musicSearchCache[cacheKey] = results
        self:_renderMusicList(results); self:_setMusicUiStatus(#results > 0 and "Chon ket qua de phat" or "Khong co ket qua")
    end)
end

function FeedbackWidget:_queueMusicSearch(query)
    self._musicSearchToken = (self._musicSearchToken or 0) + 1
    local token, trimmed = self._musicSearchToken, trimString(query)
    if trimmed == "" then if self.music.viewMode == "search" then self:_renderMusicList({}); self:_setMusicUiStatus("Nhap ten hoac ID audio") end; return end
    if not trimmed:match("^rbxassetid://%d+$") and not trimmed:match("^%d+$") and #trimmed < 2 then self:_renderMusicList({}); self:_setMusicUiStatus("Nhap it nhat 2 ky tu hoac ID"); return end
    task.delay(self.config.musicSearchDebounce, function()
        if token == self._musicSearchToken and self.state.mounted and self.music.viewMode == "search" then self:_runMusicSearch(trimmed, token) end
    end)
end

