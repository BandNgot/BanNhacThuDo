function FeedbackWidget:_applyGlassRadius(frame, targetRadius, duration, expanded)
    local glass = self._glass and self._glass[frame]
    if not glass then
        local c = frame and frame:FindFirstChildOfClass("UICorner")
        if c then
            if duration then self:_trackTween("panel", c, duration, {CornerRadius = targetRadius}) else c.CornerRadius = targetRadius end
        end
        return
    end
    local innerRadius = shrinkCornerRadius(targetRadius, 1)
    for _, pair in ipairs({{glass.mainCorner, targetRadius}, {glass.bevelCorner, innerRadius}}) do
        if pair[1] then
            if duration then self:_trackTween("panel", pair[1], duration, {CornerRadius = pair[2]}) else pair[1].CornerRadius = pair[2] end
        end
    end
    for _, c in ipairs(glass.lensCorners or {}) do
        if duration then self:_trackTween("panel", c, duration, {CornerRadius = targetRadius}) else c.CornerRadius = targetRadius end
    end
    if expanded ~= nil then
        if glass.panelGrad then glass.panelGrad.Transparency = expanded and SHEET_BG_SEQ or ISLAND_BG_SEQ end
        if glass.outerStroke then glass.outerStroke.Thickness = expanded and 1.5 or 1.25 end
    end
end

function FeedbackWidget:_syncShadowImg(img, expanded, duration)
    if not img then return end
    local props = expanded
        and {Size = UDim2.new(1, 34, 1, 34), Position = UDim2.new(0.5, 0, 0.5, 5), ImageTransparency = 0.78}
        or {Size = UDim2.new(1, 22, 1, 22), Position = UDim2.new(0.5, 0, 0.5, 3), ImageTransparency = 0.84}
    if duration then
        self:_trackTween("panel", img, duration, props)
    else
        img.Size, img.Position, img.ImageTransparency = props.Size, props.Position, props.ImageTransparency
    end
end

function FeedbackWidget:_setSheetOpen(targetIsland, open, instant)
    self.state.activeIsland = targetIsland or self.state.activeIsland
    local isMusic = self.state.activeIsland == "music"
    self.state.open, self._islandHovering = open == true, false
    if open then self.state.hidden = false end
    self._animToken = (self._animToken or 0) + 1
    local token = self._animToken

    local activePanel = isMusic and self._ui.musicPanel or self._ui.panel
    local otherPanel = isMusic and self._ui.panel or self._ui.musicPanel
    local activeShadow = isMusic and self._ui.musicShadow or self._ui.panelShadow
    local otherShadow = isMusic and self._ui.panelShadow or self._ui.musicShadow
    local activeShadowImg = isMusic and self._ui.musicShadowImg or self._ui.panelShadowImg
    local otherShadowImg = isMusic and self._ui.panelShadowImg or self._ui.musicShadowImg
    local activeContent = isMusic and self._ui.musicContent or self._ui.panelContent
    local collapsedFrame = isMusic and self._ui.collapsedMusic or self._ui.collapsedFeedback
    local otherCollapsed = isMusic and self._ui.collapsedFeedback or self._ui.collapsedMusic

    self:_cancelTweens("panel"); self:_cancelTweens("layout"); self:_cancelTweens("hide")
    self:_updateWorldBlur(open, instant)
    if not open then self:_hideAcrylic(); self:_clearBackdropLens(); self._sheetCustomPos = nil; self._draggingSheet = false end
    if self._ui.panelContent then self._ui.panelContent.Visible = false end
    if self._ui.musicContent then self._ui.musicContent.Visible = false end

    if open then
        self:_animatePeekTab(false, true)
        if otherPanel then
            otherPanel.Visible = false
            otherPanel.BackgroundColor3, otherPanel.BackgroundTransparency = self.theme.islandBg, self.theme.islandTransparency
            self:_applyGlassRadius(otherPanel, UDim.new(1, 0), nil, false)
        end
        if otherCollapsed then otherCollapsed.Visible = true end
        if otherShadow then otherShadow.Visible = false end
        self:_syncShadowImg(otherShadowImg, false, nil)
        if collapsedFrame then collapsedFrame.Visible = false end
        local targetSize, targetPos = self:_getSheetBounds(isMusic)
        activePanel.Visible, activePanel.ZIndex = true, 12
        if activeShadow then activeShadow.Visible, activeShadow.ZIndex = true, 10 end
        if not isMusic then self:_refreshMetaPreview(); self:_setTab(self.state.activeTab, true) else self:_updateMusicViewTabs(true) end
        local targetTransp = self.theme.panelTransparency

        if instant then
            activePanel.Size, activePanel.Position = targetSize, targetPos
            activePanel.BackgroundColor3, activePanel.BackgroundTransparency = self.theme.panelTop, targetTransp
            self:_applyGlassRadius(activePanel, self.config.glassCornerRadius, nil, true)
            if activeContent then activeContent.Visible = true end
            self:_syncShadow(activeShadow, targetPos, targetSize, true)
            self:_syncShadowImg(activeShadowImg, true, nil)
            self:_captureBackdropLens(activePanel)
            self:_updateAcrylic(); self:_updateBackdropLens()
            return
        end
        self:_applyGlassRadius(activePanel, self.config.glassCornerRadius, 0.28, true)
        self:_syncShadowImg(activeShadowImg, true, 0.28)
        self:_trackTween("panel", activePanel, 0.30, {Size = targetSize, Position = targetPos, BackgroundColor3 = self.theme.panelTop, BackgroundTransparency = targetTransp}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        if activeShadow then self:_trackTween("panel", activeShadow, 0.30, {Size = targetSize, Position = targetPos}, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
        task.delay(0.11, function()
            if token == self._animToken and self.state.mounted and self.state.open then
                if activeContent then activeContent.Visible = true end
                self:_captureBackdropLens(activePanel)
            end
        end)
    else
        local layout = self:_collapsedLayout(self.state.activeIsland, false)
        local target, otherTarget = isMusic and layout.music or layout.feedback, isMusic and layout.feedback or layout.music
        self:_syncCollapsedContent(self.state.activeIsland)
        if otherPanel then
            otherPanel.Size, otherPanel.Position, otherPanel.Visible = otherTarget.size, otherTarget.position, true
            otherPanel.BackgroundColor3, otherPanel.BackgroundTransparency = self.theme.islandBg, self.theme.islandTransparency
            self:_applyGlassRadius(otherPanel, UDim.new(1, 0), nil, false)
        end
        if otherCollapsed then otherCollapsed.Visible = true end
        if otherShadow then otherShadow.Visible = false end
        self:_syncShadowImg(otherShadowImg, false, nil)
        if activeShadow then activeShadow.Visible = false end
        if instant then
            activePanel.Size, activePanel.Position = target.size, target.position
            activePanel.BackgroundColor3, activePanel.BackgroundTransparency = self.theme.islandBg, self.theme.islandTransparency
            self:_applyGlassRadius(activePanel, UDim.new(1, 0), nil, false)
            if collapsedFrame then collapsedFrame.Visible = true end
            self:_syncShadow(activeShadow, target.position, target.size, false)
            self:_syncShadowImg(activeShadowImg, false, nil)
            self:_scheduleAutoHide()
            return
        end
        self:_applyGlassRadius(activePanel, UDim.new(1, 0), 0.24, false)
        self:_syncShadowImg(activeShadowImg, false, 0.24)
        self:_trackTween("panel", activePanel, 0.26, {Size = target.size, Position = target.position, BackgroundColor3 = self.theme.islandBg, BackgroundTransparency = self.theme.islandTransparency})
        task.delay(0.20, function()
            if token == self._animToken and self.state.mounted and not self.state.open then
                if collapsedFrame then collapsedFrame.Visible = true end
                self:_scheduleAutoHide()
            end
        end)
    end
end

