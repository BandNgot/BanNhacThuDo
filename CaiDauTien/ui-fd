    local btn = self._ui.submitButton
    if btn then
        btn.Text = sending and "Dang gui..." or "Gui phan hoi"
        btn.AutoButtonColor = not sending
        btn.BackgroundColor3 = sending and self.theme.accentDim or self.theme.accent
