    local activeIdx = 1
    for i, tab in ipairs(MUSIC_TABS) do
        local btn, selected = self._ui.musicViewButtons and self._ui.musicViewButtons[tab.key], tab.key == mode
        if selected then activeIdx = i end
        if btn then btn.Text = labels[tab.key]; btn.TextColor3 = selected and self.theme.text or self.theme.textDim; btn.Font = selected and FONT_BOLD or FONT_MEDIUM end
    end
    self:_positionSegmentIndicator(self._ui.musicTabIndicator, MUSIC_TABS, activeIdx, not instant)
    if self._ui.musicSearchRow then self._ui.musicSearchRow.Visible = mode == "search" end
    if self._ui.musicResultsScroll then
