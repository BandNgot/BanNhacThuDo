function FeedbackWidget:_cancelTweens(group)
    if not self._tweens then return end
    local function cancelList(list) for _, tw in ipairs(list) do pcall(function() tw:Cancel() end) end end
    if group then if self._tweens[group] then cancelList(self._tweens[group]); self._tweens[group] = nil end; return end
    for k, list in pairs(self._tweens) do cancelList(list); self._tweens[k] = nil end
end

function FeedbackWidget:_trackTween(group, obj, duration, props, style, direction)
    if not obj then return nil end
    self._tweens[group] = self._tweens[group] or {}
    local list = self._tweens[group]
    local tw = TweenService:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out), props)
    table.insert(list, tw)
    local conn
    conn = tw.Completed:Connect(function()
        if conn then conn:Disconnect() end
        local cur = self._tweens and self._tweens[group]
        if cur then for i = #cur, 1, -1 do if cur[i] == tw then table.remove(cur, i) break end end end
    end)
    tw:Play()
    return tw
end

function FeedbackWidget:_updateWorldBlur(open, instant)
    local blurSize = tonumber(self.config.glassBlur) or 0
    local wantBlur = open and self.config.liquidGlass and blurSize > 0 and self.config.useWorldBlur == true
    local blur = self._worldBlur
    if not wantBlur and not blur then return end

    if wantBlur then
        if not blur or not blur.Parent then
            local ok, created = pcall(function() return create("BlurEffect", {Name = "DacCauLiquidGlassBlur_" .. tostring(self.config.guiName), Size = 0, Enabled = true}, Lighting) end)
            if not ok then return end
            blur, self._worldBlur = created, created
        end
        self:_cancelTweens("blur")
        if instant then blur.Size = blurSize else self:_trackTween("blur", blur, 0.26, {Size = blurSize}) end
    elseif blur then
        self:_cancelTweens("blur")
        if instant then pcall(function() blur:Destroy() end); self._worldBlur = nil
        else
            local tw = self:_trackTween("blur", blur, 0.20, {Size = 0})
            if tw then
                local c
                c = tw.Completed:Connect(function()
                    if c then c:Disconnect() end
                    if not self.state.open and self._worldBlur == blur then pcall(function() blur:Destroy() end); self._worldBlur = nil end
                end)
            end
        end
    end
end

-- Per-Panel 3D Glass Acrylic Engine (Roblox DepthOfField + Glass Wedges) ----

local function drawAcrylicTriangle(v1, v2, v3, p0, p1, meshId)
    local s1, s2, s3 = (v1 - v2).Magnitude, (v2 - v3).Magnitude, (v3 - v1).Magnitude
    local smax = math.max(s1, s2, s3)
    if smax < 1e-4 then return p0, p1 end
    local A, B, C
    if s1 == smax then A, B, C = v1, v2, v3 elseif s2 == smax then A, B, C = v2, v3, v1 else A, B, C = v3, v1, v2 end

    local ab = A - B
    local abMag = ab.Magnitude
    if abMag < 1e-4 then return p0, p1 end
    local para = ((B.X - A.X) * (C.X - A.X) + (B.Y - A.Y) * (C.Y - A.Y) + (B.Z - A.Z) * (C.Z - A.Z)) / abMag
    local perp = math.sqrt(math.max(0, (C - A).Magnitude ^ 2 - para * para))
    if perp < 1e-4 then return p0, p1 end
    local difPara = abMag - para

    local st, za = CFrame.new(B, A), CFrame.Angles(math.pi / 2, 0, 0)
    local topLook = (st * za).LookVector
    local midPt = A + CFrame.new(A, B).LookVector * para
    local needLook = CFrame.new(midPt, C).LookVector
    local dot = math.clamp(topLook:Dot(needLook), -1, 1)
    local angle = math.acos(dot)
    local ac = CFrame.Angles(0, 0, angle)

    local cf0 = st * ac
    if ((cf0 * za).LookVector - needLook).Magnitude > 0.01 then cf0 = st * CFrame.Angles(0, 0, -angle) end
    cf0 = cf0 * CFrame.new(0, perp / 2, -(difPara + para / 2))

    local cf1 = st * ac * CFrame.Angles(0, math.pi, 0)
    if ((cf1 * za).LookVector - needLook).Magnitude > 0.01 then cf1 = st * CFrame.Angles(0, 0, -angle) * CFrame.Angles(0, math.pi, 0) end
    cf1 = cf1 * CFrame.new(0, perp / 2, difPara / 2)

    local sz = 0.2
    local function ensureWedge(part)
        if part and part:FindFirstChild(meshId) then return part end
        local p = create("Part", {
            Anchored = true, CanCollide = false, CastShadow = false, Material = Enum.Material.Glass,
            Transparency = 0.988, Color = Color3.fromRGB(150, 165, 188), Reflectance = 0,
            Size = Vector3.new(sz, sz, sz), Name = "DacCauAcrylicWedge"
        })
        create("SpecialMesh", {Name = meshId, MeshType = Enum.MeshType.Wedge}, p)
        return p
    end

    p0, p1 = ensureWedge(p0), ensureWedge(p1)
    p0[meshId].Scale, p0.CFrame = Vector3.new(0, perp / sz, para / sz), cf0
    p1[meshId].Scale, p1.CFrame = Vector3.new(0, perp / sz, difPara / sz), cf1
    return p0, p1
end

function FeedbackWidget:_hideAcrylic()
    local ac = self._acrylic
    if not ac then return end
    if ac.dof then
        pcall(function() ac.dof.Enabled = false; ac.dof.Parent = nil end)
    end
    for _, pt in ipairs(ac.parts or {}) do
        pcall(function() pt.Parent = nil end)
    end
end

function FeedbackWidget:_destroyAcrylic()
    local ac = self._acrylic
    if not ac then return end
    if ac.dof then pcall(function() ac.dof:Destroy() end) end
    for _, pt in ipairs(ac.parts or {}) do pcall(function() pt:Destroy() end) end
    self._acrylic = nil
end

function FeedbackWidget:_updateAcrylic()
    local blurSize = tonumber(self.config.glassBlur) or 0
    local screenGui = self._ui and self._ui.screenGui
    local wantAcrylic = self.state.mounted and self.state.open and screenGui and screenGui.Parent ~= nil and self.config.liquidGlass and blurSize > 0 and self.config.useWorldBlur ~= true
    if not wantAcrylic then self:_hideAcrylic(); return end

    local cam = workspace.CurrentCamera
    local isMusic = self.state.activeIsland == "music"
    local activePanel = isMusic and self._ui.musicPanel or self._ui.panel
    if not cam or not activePanel or not activePanel.Visible or not activePanel:IsDescendantOf(screenGui) then self:_hideAcrylic(); return end
    local absSize = activePanel.AbsoluteSize
    if absSize.X < 24 or absSize.Y < 24 then self:_hideAcrylic(); return end

    local ac = self._acrylic
    if not ac then
        local ok, dof = pcall(function()
            return create("DepthOfFieldEffect", {
                Name = "DacCauAcrylicDOF_" .. tostring(self.config.guiName),
                FarIntensity = 0, FocusDistance = 51.6, InFocusRadius = 50, NearIntensity = 0.45, Enabled = true
            })
        end)
        if not ok then return end
        ac = {dof = dof, parts = {}, meshId = "AcrylicWedge"}
        self._acrylic = ac
    end

    local inset, bevel = 5, 20
    local absPos = activePanel.AbsolutePosition
    local x0, y0 = absPos.X + inset, absPos.Y + inset
    local x1, y1 = absPos.X + absSize.X - inset, absPos.Y + absSize.Y - inset
    if x1 - x0 <= bevel * 2 + 4 or y1 - y0 <= bevel * 2 + 4 then self:_hideAcrylic(); return end

    local function rayPt(px, py)
        return cam:ScreenPointToRay(px, py, 0.42).Origin
    end

    local ok, cTL, cTR, cBL, cBR, tL, tR, bL, bR, lT, lB, rT, rB = pcall(function()
        return rayPt(x0 + bevel, y0 + bevel), rayPt(x1 - bevel, y0 + bevel),
            rayPt(x0 + bevel, y1 - bevel), rayPt(x1 - bevel, y1 - bevel),
            rayPt(x0 + bevel, y0), rayPt(x1 - bevel, y0),
            rayPt(x0 + bevel, y1), rayPt(x1 - bevel, y1),
            rayPt(x0, y0 + bevel), rayPt(x0, y1 - bevel),
            rayPt(x1, y0 + bevel), rayPt(x1, y1 - bevel)
    end)
    if not ok or cTL.X ~= cTL.X or cBR.X ~= cBR.X then self:_hideAcrylic(); return end

    if not ac.dof.Parent then ac.dof.Parent = Lighting end
    ac.dof.Enabled = true
    local quads = {
        {cTL, cTR, cBL, cBR},
        {tL, tR, cTL, cTR},
        {cBL, cBR, bL, bR},
        {lT, cTL, lB, cBL},
        {cTR, rT, cBR, rB}
    }
    for idx, q in ipairs(quads) do
        local pIdx = (idx - 1) * 4
        ac.parts[pIdx + 1], ac.parts[pIdx + 2] = drawAcrylicTriangle(q[1], q[2], q[3], ac.parts[pIdx + 1], ac.parts[pIdx + 2], ac.meshId)
        ac.parts[pIdx + 3], ac.parts[pIdx + 4] = drawAcrylicTriangle(q[3], q[2], q[4], ac.parts[pIdx + 3], ac.parts[pIdx + 4], ac.meshId)
    end
    for _, pt in ipairs(ac.parts) do
        if pt and pt.Parent ~= cam then pt.Parent = cam end
    end
end

-- 2D Hub Convex Lens & Edge Refraction Engine -------------------------------

local SYSTEM_GUI_SKIP = {
    RobloxGui = true, TopBarApp = true, BubbleChat = true, Chat = true, PlayerList = true,
    TouchGui = true, PurchasePromptApp = true, CoreScriptLocalization = true, Freecam = true,
    HeadsetDisconnectedDialog = true, RobloxPromptGui = true, RobloxLoadingGui = true,
    DevConsoleMaster = true, TeleportGui = true
}

local LENS_KEEP_MODIFIERS = {
    UICorner = true, UIGradient = true, UIStroke = true, UIPadding = true,
    UIListLayout = true, UIGridLayout = true, UIPageLayout = true, UITableLayout = true,
    UIAspectRatioConstraint = true, UISizeConstraint = true, UITextSizeConstraint = true, UIScale = true
}

local function makeLensGroup(parent, zIndex, transp, tint, rot, edgeSeq, sizeScale, radius)
    local ok, grp = pcall(function()
        return create("CanvasGroup", {
            BackgroundTransparency = 1, BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(sizeScale or 1, sizeScale or 1),
            GroupTransparency = transp or 0, GroupColor3 = tint or Color3.fromRGB(255, 255, 255), ZIndex = zIndex
        }, parent)
    end)
    if not ok or not grp then
        grp = create("Frame", {
            BackgroundTransparency = 1, ClipsDescendants = true,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(sizeScale or 1, sizeScale or 1), ZIndex = zIndex
        }, parent)
    end
    local c = addCorner(grp, radius or UDim.new(1, 0))
    if edgeSeq then
        create("UIGradient", {Rotation = rot or 45, Transparency = edgeSeq}, grp)
    end
    return grp, c
end

function FeedbackWidget:_ensurePanelLensRig(panel)
    self._lensRigs = self._lensRigs or {}
    if self._lensRigs[panel] then return self._lensRigs[panel] end

    local root = create("Frame", {Name = "LiquidLensRoot", BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 13}, panel)
    local rootCorner = addCorner(root, UDim.new(1, 0))

    -- mainWave: container trong suốt hoàn toàn - chỉ để clip strips, không tô màu
    local mainWave, mainCorner = makeLensGroup(root, 13, 0, Color3.new(1,1,1), nil, nil, 1)
    -- Không dùng blurWave riêng nữa (gây ra blob chói)
    local blurWave = mainWave  -- alias, dùng chung container

    local function buildStrips(parent, count)
        local strips = {}
        for i = 1, count do
            local t0 = (i - 1) / count
            local s = create("Frame", {
                Name = "WaveStrip_" .. tostring(i), BackgroundTransparency = 1, ClipsDescendants = true,
                Position = UDim2.fromScale(0, t0), Size = UDim2.new(1, 0, 1 / count, 1), ZIndex = 13
            }, parent)
            strips[i] = {frame = s, t0 = t0, t = (i - 0.5) / count, entries = {}}
        end
        return strips
    end

    local mainStrips = buildStrips(mainWave, 12)
    -- blurStrips dùng lại mainStrips (không tạo thêm strips chói)
    local blurStrips = mainStrips

    -- Veil: CHỈ là lớp mờ cực nhẹ phía trên clone, KHÔNG gradient "mặt trời"
    local veil = create("Frame", {
        Name = "FrostedVeil",
        BackgroundColor3 = self.theme.glassStyle == "light"
            and Color3.fromRGB(240, 245, 255)
            or  Color3.fromRGB(18, 22, 36),
        BackgroundTransparency = 0.94,  -- cực trong suốt, chỉ tô nhẹ
        BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 14
    }, panel)
    local veilCorner = addCorner(veil, UDim.new(1, 0))
    -- KHÔNG thêm UIGradient vào veil - đó là nguồn gây "mặt trời"

    local glass = self._glass and self._glass[panel]
    if glass and glass.lensCorners then
        for _, c in ipairs({rootCorner, mainCorner, veilCorner}) do
            table.insert(glass.lensCorners, c)
        end
    end

    local rig = {root = root, mainWave = mainWave, blurWave = blurWave, mainStrips = mainStrips, blurStrips = blurStrips, veil = veil, entries = {}, activePanel = panel}
    self._lensRigs[panel] = rig
    return rig
end

function FeedbackWidget:_cloneGuiForLens(src)
    local budget = {count = 0, limit = 80}
    local function sanitizeNode(node, srcNode)
        if node:IsA("GuiObject") then
            pcall(function() node.Active = false; node.Selectable = false end)
            if node:IsA("TextBox") then pcall(function() node.TextEditable = false end) end
            if node:IsA("ScrollingFrame") and srcNode and srcNode:IsA("ScrollingFrame") then
                pcall(function() node.CanvasPosition = srcNode.CanvasPosition end)
            end
        end
    end

    local function copyVisible(node, depth)
        if budget.count >= budget.limit or depth > 6 then return nil end
        if node:IsA("BaseScript") or node:IsA("Sound") or node:IsA("BillboardGui") or node:IsA("SurfaceGui") then return nil end
        if node:IsA("GuiObject") then
            if not node.Visible then return nil end
        elseif not LENS_KEEP_MODIFIERS[node.ClassName] and not node:IsA("Folder") then
            return nil
        end

        local okCopy, copyObj = pcall(function()
            local prevArchivable = node.Archivable
            node.Archivable = true
            local cloneShallow = node:Clone()
            node.Archivable = prevArchivable
            if cloneShallow then
                for _, c in ipairs(cloneShallow:GetChildren()) do c:Destroy() end
            end
            return cloneShallow
        end)
        if not okCopy or not copyObj then return nil end
        if node:IsA("GuiObject") then budget.count = budget.count + 1 end
        sanitizeNode(copyObj, node)

        for _, child in ipairs(node:GetChildren()) do
            if budget.count >= budget.limit then break end
            local childCopy = copyVisible(child, depth + 1)
            if childCopy then childCopy.Parent = copyObj end
        end
        return copyObj
    end

    return copyVisible(src, 0)
end

function FeedbackWidget:_scanBackdropWindows()
    local ownGui = self._ui and self._ui.screenGui
    local targets, seenGuis, windows = {}, {}, {}

    local function pushGui(gui)
        if not gui or seenGuis[gui] or gui == ownGui then return end
        if gui:IsA("ScreenGui") and gui.Enabled and not SYSTEM_GUI_SKIP[gui.Name] then
            if ownGui and (gui.DisplayOrder or 0) > (ownGui.DisplayOrder or 100) then return end
            seenGuis[gui] = true
            table.insert(targets, gui)
        end
    end

    if self.config.backdropGui then
        if typeof(self.config.backdropGui) == "Instance" then
            if self.config.backdropGui:IsA("ScreenGui") then
                pushGui(self.config.backdropGui)
            elseif self.config.backdropGui:IsA("GuiObject") then
                local ancestorGui = self.config.backdropGui:FindFirstAncestorOfClass("ScreenGui")
                table.insert(windows, {source = self.config.backdropGui, sourceGui = ancestorGui})
                return windows
            end
        end
    end

    local roots = {}
    if ownGui and ownGui.Parent then table.insert(roots, ownGui.Parent) end
    pcall(function() if type(gethui) == "function" then table.insert(roots, gethui()) end end)
    pcall(function() table.insert(roots, CoreGui) end)
    pcall(function()
        local plr = Players.LocalPlayer
        local pg = plr and plr:FindFirstChildOfClass("PlayerGui")
        if pg then table.insert(roots, pg) end
    end)

    for _, root in ipairs(roots) do
        pcall(function()
            for _, child in ipairs(root:GetChildren()) do pushGui(child) end
        end)
    end

    for _, gui in ipairs(targets) do
        for _, child in ipairs(gui:GetChildren()) do
            if child:IsA("GuiObject") and child.Visible and child.AbsoluteSize.X >= 80 and child.AbsoluteSize.Y >= 50 then
                table.insert(windows, {source = child, sourceGui = gui})
            end
        end
    end
    return windows
end

function FeedbackWidget:_clearBackdropLens(panel)
    self._lensCaptureToken = (self._lensCaptureToken or 0) + 1
    if not self._lensRigs then return end
    local function wipeRig(rig)
        if not rig then return end
        for _, s in ipairs(rig.mainStrips or {}) do
            for _, node in ipairs(s.entries or {}) do
                if node.wrap then pcall(function() node.wrap:Destroy() end) end
            end
            s.entries = {}
        end
        rig.entries = {}
        if rig.root then rig.root.Visible = false end
        if rig.veil then rig.veil.Visible = false end
    end
    if panel then wipeRig(self._lensRigs[panel]) else for _, rig in pairs(self._lensRigs) do wipeRig(rig) end end
    if not panel then self._activeLensPanel = nil end
end

function FeedbackWidget:_captureBackdropLens(panel)
    if not panel then return end
    local rig = self:_ensurePanelLensRig(panel)
    self:_clearBackdropLens(panel)
    self._activeLensPanel = panel
    self._lensCaptureToken = (self._lensCaptureToken or 0) + 1
    local captureToken = self._lensCaptureToken

    if not self.config.liquidGlass or not self.config.backdropLens then
        rig.veil.Visible = false
        panel.BackgroundTransparency = self.theme.panelTransparency
        return
    end

    rig.root.Visible = true
    rig.veil.Visible = true

    local windows = self:_scanBackdropWindows()
    if #windows == 0 then
        panel.BackgroundTransparency = self.theme.panelTransparency
        return
    end

    panel.BackgroundTransparency = 0.96

    task.spawn(function()
        for _, win in ipairs(windows) do
            if captureToken ~= self._lensCaptureToken or not self.state.mounted or not self.state.open then return end
            local src, srcGui = win.source, win.sourceGui
            if src and src.Parent then
                local guiScaleObj = srcGui and srcGui:FindFirstChildOfClass("UIScale")
                local guiScale = (guiScaleObj and guiScaleObj.Scale > 0) and guiScaleObj.Scale or 1
                local srcScaleObj = src:FindFirstChildOfClass("UIScale")
                local srcScale = (srcScaleObj and srcScaleObj.Scale > 0) and srcScaleObj.Scale or 1
                local totalSrcScale = math.max(0.1, guiScale * srcScale)
                local unscaledW = src.AbsoluteSize.X / totalSrcScale
                local unscaledH = src.AbsoluteSize.Y / totalSrcScale

                local baseClone = self:_cloneGuiForLens(src)
                if baseClone then
                    local cloneScale = baseClone:FindFirstChildOfClass("UIScale")
                    if cloneScale then cloneScale:Destroy() end
                    baseClone.AnchorPoint = Vector2.new(0, 0)
                    baseClone.Size = UDim2.fromOffset(unscaledW, unscaledH)

                    local stripNodes = {}
                    local entry = {source = src, sourceGui = srcGui, nodes = stripNodes}
                    table.insert(rig.entries, entry)

                    local BASE_MAG = 1.04
                    local BULGE = 0.42
                    for idx, s in ipairs(rig.mainStrips) do
                        if captureToken ~= self._lensCaptureToken or not self.state.mounted or not self.state.open then
                            if idx == 1 then pcall(function() baseClone:Destroy() end) end
                            return
                        end
                        local cloneObj = (idx == 1) and baseClone or baseClone:Clone()
                        if cloneObj then
                            local wrap = create("Frame", {
                                BackgroundTransparency = 1, BorderSizePixel = 0,
                                AnchorPoint = Vector2.new(0, 0),
                                Size = UDim2.fromOffset(unscaledW, unscaledH), ZIndex = 13
                            }, s.frame)
                            local scaleInst = create("UIScale", {Scale = totalSrcScale}, wrap)
                            cloneObj.Parent = wrap
                            local rec = {
                                wrap = wrap, scale = scaleInst, strip = s,
                                baseMag = BASE_MAG, bulgeFactor = BULGE
                            }
                            table.insert(s.entries, rec)
                            table.insert(stripNodes, rec)
                        end
                        if idx % 3 == 0 then
                            self:_updateBackdropLens()
                            RunService.Heartbeat:Wait()
                        end
                    end
                    self:_updateBackdropLens()
                end
            end
        end
    end)
end

function FeedbackWidget:_updateBackdropLens()
    if not self.state.mounted or not self.state.open or not self._activeLensPanel then return end
    local panel = self._activeLensPanel
    local rig = self._lensRigs and self._lensRigs[panel]
    if not rig or not rig.root.Visible or #rig.entries == 0 then return end

    local panelPos = panel.AbsolutePosition
    local pSize = panel.AbsoluteSize
    if pSize.X <= 4 or pSize.Y <= 4 then return end
    local pcX = panelPos.X + pSize.X * 0.5
    local pcY = panelPos.Y + pSize.Y * 0.5

    local phase = os.clock() * 1.15

    for _, entry in ipairs(rig.entries) do
        local src, srcGui = entry.source, entry.sourceGui
        local alive = src and src.Parent ~= nil and src.Visible and (not srcGui or srcGui.Enabled)
        if not alive then
            for _, rec in ipairs(entry.nodes) do rec.wrap.Visible = false end
        else
            local srcPos = src.AbsolutePosition
            local guiScaleObj = srcGui and srcGui:FindFirstChildOfClass("UIScale")
            local guiScale = (guiScaleObj and guiScaleObj.Scale > 0) and guiScaleObj.Scale or 1
            local srcScaleObj = src:FindFirstChildOfClass("UIScale")
            local srcScale = (srcScaleObj and srcScaleObj.Scale > 0) and srcScaleObj.Scale or 1
            local totalSrcScale = math.max(0.1, guiScale * srcScale)

            for _, rec in ipairs(entry.nodes) do
                local t = rec.strip.t
                local t0 = rec.strip.t0 or (t - 0.5 / 12)
                local dist = t - 0.5
                local bulge = 1 - 4 * dist * dist
                local mag = rec.baseMag + rec.bulgeFactor * bulge
                local waveX = math.sin(t * 7.0 + phase) * 5 * bulge
                local waveY = math.cos(t * 5.2 + phase * 0.85) * 3 * bulge

                local targetSrcX = pcX + (srcPos.X - pcX) * mag
                local targetSrcY = pcY + (srcPos.Y - pcY) * mag
                local stripTopY = panelPos.Y + t0 * pSize.Y

                rec.wrap.Visible = true
                rec.scale.Scale = totalSrcScale * mag
                rec.wrap.Position = UDim2.fromOffset((targetSrcX - panelPos.X) + waveX, (targetSrcY - stripTopY) + waveY)
            end
        end
    end
end

-- Safe Area, Dynamic Island Layout & Auto-Hide -------------------------------

function FeedbackWidget:_getSafeTopBase()
    if not self.config.respectTopInset or not self._ignoreGuiInset then return 0 end
    local ok, topLeft = pcall(function() return GuiService:GetGuiInset() end)
    local insetY = (ok and topLeft and type(topLeft.Y) == "number") and topLeft.Y or 0
    return insetY > 0 and insetY or 36
end

function FeedbackWidget:_getScreenSize()
    local gui = self._ui.screenGui
    if gui and gui.AbsoluteSize and gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.Y > 0 then return gui.AbsoluteSize end
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(1920, 1080)
end

function FeedbackWidget:_getExpandedTop() return self:_getSafeTopBase() + (self.config.expandedTopOffset or 12) end

function FeedbackWidget:_collapsedLayout(mode, hidden)
    local activeMode = mode or self.state.activeIsland or "feedback"
    local h, circle, gap = self.config.collapsedHeight, self.config.sideButtonSize, self.config.switchGap
    local fbW = activeMode == "feedback" and self.config.collapsedWidth or circle
    local muW = activeMode == "music" and self.config.musicWidth or circle
    local totalW = fbW + gap + muW
    local top = hidden and (self.config.hiddenTopOffset ~= nil and self.config.hiddenTopOffset or -(h + 18)) or (self:_getSafeTopBase() + (self.config.topOffset or 10))
    return {
        feedback = {position = UDim2.new(0.5, -totalW / 2 + fbW / 2, 0, top), size = UDim2.fromOffset(fbW, h)},
        music = {position = UDim2.new(0.5, totalW / 2 - muW / 2, 0, top), size = UDim2.fromOffset(muW, h)}
    }
end

function FeedbackWidget:_getSheetBounds(isMusic)
    local screen, expandedTop = self:_getScreenSize(), self:_getExpandedTop()
    local w = math.min(self.config.panelWidth, math.max(self.config.collapsedWidth, screen.X - 24))
    local h = math.min(isMusic and self.config.musicPanelHeight or self.config.panelHeight, math.max(self.config.collapsedHeight, screen.Y - expandedTop - 16))
    if self._sheetCustomPos then
        local minX, maxX = w * 0.5 + 8, math.max(w * 0.5 + 8, screen.X - w * 0.5 - 8)
        local minY, maxY = self:_getSafeTopBase() + 6, math.max(self:_getSafeTopBase() + 6, screen.Y - h - 8)
        return UDim2.fromOffset(w, h), UDim2.fromOffset(math.clamp(self._sheetCustomPos.X, minX, maxX), math.clamp(self._sheetCustomPos.Y, minY, maxY))
    end
    local maxY = math.max(expandedTop, screen.Y - h - 16)
    local openY = math.clamp(math.floor(screen.Y * 0.45 - h * 0.5), expandedTop, maxY)
    return UDim2.fromOffset(w, h), UDim2.new(0.5, 0, 0, openY)
end

function FeedbackWidget:_syncShadow(shadow, pos, size, visible)
    if shadow then shadow.Position, shadow.Size, shadow.Visible = pos, size, visible ~= false end
end

function FeedbackWidget:_syncCollapsedContent(mode)
    local ui, isFb = self._ui, (mode or self.state.activeIsland) == "feedback"
    if ui.collapsedFeedbackIconOnly then ui.collapsedFeedbackIconOnly.Visible = not isFb end
    if ui.collapsedFeedbackFull then ui.collapsedFeedbackFull.Visible = isFb end
    if ui.collapsedMusicIconOnly then ui.collapsedMusicIconOnly.Visible = isFb end
    if ui.collapsedMusicFull then ui.collapsedMusicFull.Visible = not isFb end
end

function FeedbackWidget:_applyCollapsedLayout(animate, mode)
    local ui = self._ui
    if not ui.panel or not ui.musicPanel then return end
    local activeMode = mode or self.state.activeIsland or "feedback"
    self.state.activeIsland = activeMode
    local hidden = self.state.hidden and not self.state.open
    local layout = self:_collapsedLayout(activeMode, hidden)
    self:_syncCollapsedContent(activeMode)
    ui.panel.Visible, ui.musicPanel.Visible = not hidden, not hidden
    if ui.panelContent then ui.panelContent.Visible = false end
    if ui.musicContent then ui.musicContent.Visible = false end

    self:_cancelTweens("layout")
    if animate then
        for _, pair in ipairs({{ui.panel, ui.panelShadow, layout.feedback}, {ui.musicPanel, ui.musicShadow, layout.music}}) do
            self:_trackTween("layout", pair[1], 0.28, {Size = pair[3].size, Position = pair[3].position}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            if pair[2] then pair[2].Visible = false end
        end
    else
        ui.panel.Size, ui.panel.Position = layout.feedback.size, layout.feedback.position
        ui.musicPanel.Size, ui.musicPanel.Position = layout.music.size, layout.music.position
        self:_syncShadow(ui.panelShadow, layout.feedback.position, layout.feedback.size, false)
        self:_syncShadow(ui.musicShadow, layout.music.position, layout.music.size, false)
    end
end

function FeedbackWidget:_animatePeekTab(show, instant)
    local peek = self._ui.peekTab
    if not peek then return end
    local targetPos = UDim2.new(0.5, 0, 0, show and (self:_getSafeTopBase() + 4) or -36)
    self:_cancelTweens("peek")
    if instant then peek.Position, peek.Visible = targetPos, show; return end
    if show then peek.Visible = true end
    local tw = self:_trackTween("peek", peek, 0.22, {Position = targetPos})
    if not show and tw then
        local c
        c = tw.Completed:Connect(function() if c then c:Disconnect() end; if self.state.mounted and not self.state.hidden then peek.Visible = false end end)
    end
end

function FeedbackWidget:_setIslandHidden(hidden, instant)
    if (self.state.open and hidden) or (self.state.hidden == hidden and not instant) then return end
    self.state.hidden = hidden
    self._hideToken = (self._hideToken or 0) + 1
    local hideToken, ui = self._hideToken, self._ui
    if hidden then self._islandHovering = false end
    local layout = self:_collapsedLayout(self.state.activeIsland, hidden)
    self:_cancelTweens("hide")

    if instant then
        ui.panel.Position, ui.panel.Size, ui.panel.Visible = layout.feedback.position, layout.feedback.size, not hidden
        ui.musicPanel.Position, ui.musicPanel.Size, ui.musicPanel.Visible = layout.music.position, layout.music.size, not hidden
        self:_syncShadow(ui.panelShadow, layout.feedback.position, layout.feedback.size, false)
        self:_syncShadow(ui.musicShadow, layout.music.position, layout.music.size, false)
        self:_animatePeekTab(hidden, true)
        return
    end
    if not hidden then
        ui.panel.Visible, ui.musicPanel.Visible = true, true
        if ui.panelShadow then ui.panelShadow.Visible = false end
        if ui.musicShadow then ui.musicShadow.Visible = false end
        self:_animatePeekTab(false, false)
    end
    for _, pair in ipairs({{ui.panel, ui.panelShadow, layout.feedback}, {ui.musicPanel, ui.musicShadow, layout.music}}) do
        self:_trackTween("hide", pair[1], 0.24, {Position = pair[3].position, Size = pair[3].size})
    end
    if hidden then
        task.delay(0.25, function()
            if hideToken ~= self._hideToken or not self.state.mounted or not self.state.hidden or self.state.open then return end
            ui.panel.Visible, ui.musicPanel.Visible = false, false
            if ui.panelShadow then ui.panelShadow.Visible = false end
            if ui.musicShadow then ui.musicShadow.Visible = false end
            self:_animatePeekTab(true, false)
        end)
    end
end

function FeedbackWidget:_isPointerNearIsland()
    local pos, screen = UserInputService:GetMouseLocation(), self:_getScreenSize()
    local cx, halfW = screen.X * 0.5, (self.config.revealHoverWidth or 340) * 0.5
    return pos.X >= cx - halfW and pos.X <= cx + halfW and pos.Y >= 0 and pos.Y <= (self:_getSafeTopBase() + (self.config.revealHoverHeight or 90))
end

function FeedbackWidget:_hasFocusedInput()
    local focused = UserInputService:GetFocusedTextBox()
    return focused ~= nil and self._ui.screenGui ~= nil and focused:IsDescendantOf(self._ui.screenGui)
end

function FeedbackWidget:_scheduleAutoHide()
    self._hideToken = (self._hideToken or 0) + 1
    local token, delaySec = self._hideToken, tonumber(self.config.autoHideDelay) or 10
    if delaySec <= 0 then return end
    task.delay(delaySec, function()
        if token ~= self._hideToken or not self.state.mounted or self.state.open then return end
        if self._islandHovering or self:_hasFocusedInput() or self:_isPointerNearIsland() then self:_scheduleAutoHide(); return end
        self:_setIslandHidden(true, false)
    end)
end

function FeedbackWidget:_markIslandActivity()
    if not self.state.mounted then return end
    if self.state.hidden and not self.state.open then self:_setIslandHidden(false, false) end
    if not self.state.open then self:_scheduleAutoHide() end
end

function FeedbackWidget:_updateReactiveSheens(mousePos)
    for _, item in ipairs(self._reactiveSheens) do
        local h, rg = item.host, item.rimGrad
        if h and rg and h.Visible and h.AbsoluteSize.X > 0 and h.AbsoluteSize.Y > 0 then
            local rx = math.clamp((mousePos.X - h.AbsolutePosition.X) / h.AbsoluteSize.X, 0, 1) - 0.5
            local ry = math.clamp((mousePos.Y - h.AbsolutePosition.Y) / h.AbsoluteSize.Y, 0, 1) - 0.5
            rg.Rotation = 45 + rx * 26
            rg.Offset = Vector2.new(math.clamp(rx * 0.18, -0.14, 0.14), math.clamp(ry * 0.12, -0.08, 0.08))
        end
    end
end

-- Toast, Feedback Logic & Sheet Transitions ----------------------------------

function FeedbackWidget:_setStatus(text, mode)
    local lbl = self._ui.statusLabel
    if not lbl then return end
    lbl.Text = text or ""
    lbl.TextColor3 = mode == "ok" and self.theme.ok or (mode == "err" and self.theme.err or self.theme.textDim)
end

function FeedbackWidget:_showToast(text, mode)
    local ui = self._ui
    if not ui.toast or not ui.toastText then return end
    self._toastToken = (self._toastToken or 0) + 1
    local token, color = self._toastToken, mode == "ok" and self.theme.ok or (mode == "err" and self.theme.err or self.theme.accent)

    ui.toastText.Text = shortenText(text or "", 58)
    if ui.toastDot then ui.toastDot.BackgroundColor3 = color end
    if ui.toastStroke then ui.toastStroke.Color, ui.toastStroke.Transparency = color, 0.28 end

    local safeY = self:_getSafeTopBase() + 10
    self:_cancelTweens("toast")
    ui.toast.Position, ui.toast.BackgroundTransparency, ui.toastText.TextTransparency, ui.toast.Visible = UDim2.new(0.5, 0, 0, safeY - 14), 0.72, 0.8, true
    if ui.toastDot then ui.toastDot.BackgroundTransparency = 0 end
    self:_trackTween("toast", ui.toast, 0.24, {Position = UDim2.new(0.5, 0, 0, safeY), BackgroundTransparency = self.theme.islandTransparency}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    self:_trackTween("toast", ui.toastText, 0.20, {TextTransparency = 0})

    task.delay(2.5, function()
        if token ~= self._toastToken or not self.state.mounted then return end
        local tw = self:_trackTween("toast", ui.toast, 0.20, {Position = UDim2.new(0.5, 0, 0, safeY - 12), BackgroundTransparency = 1})
        self:_trackTween("toast", ui.toastText, 0.18, {TextTransparency = 1})
        if ui.toastDot then self:_trackTween("toast", ui.toastDot, 0.18, {BackgroundTransparency = 1}) end
        if ui.toastStroke then self:_trackTween("toast", ui.toastStroke, 0.18, {Transparency = 1}) end
        if tw then
            local c
            c = tw.Completed:Connect(function() if c then c:Disconnect() end; if token == self._toastToken and ui.toast then ui.toast.Visible = false end end)
        end
    end)
end

