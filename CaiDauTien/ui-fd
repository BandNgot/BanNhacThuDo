local function shrinkCornerRadius(radius, delta)
    if typeof(radius) == "UDim" then
        return UDim.new(radius.Scale, math.max(0, radius.Offset - delta))
    end
    return UDim.new(0, math.max(0, (tonumber(radius) or 18) - delta))
end

local function applyLiquidGlass(widget, frame, opts)
    opts = opts or {}
    local theme, radius, isIsland = widget.theme, opts.radius or widget.config.glassCornerRadius, opts.isIsland == true
    frame.BackgroundColor3 = opts.bgColor or (isIsland and theme.islandBg or theme.panelTop)
    frame.BackgroundTransparency = opts.transparency or (isIsland and theme.islandTransparency or theme.panelTransparency)
    frame.BorderSizePixel = 0
    local mainCorner = addCorner(frame, radius)
    widget._glass = widget._glass or {}

    if not widget.config.liquidGlass then
        local glass = {mainCorner = mainCorner, outerStroke = addStroke(frame, theme.rim, 0.72, 1)}
        widget._glass[frame] = glass
        return glass
    end

    local panelGrad = create("UIGradient", {
        Rotation = 135,
        Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(216, 228, 248))}),
        Transparency = isIsland and ISLAND_BG_SEQ or SHEET_BG_SEQ
    }, frame)

    local outerStroke = addStroke(frame, theme.rim, 0.55, isIsland and 1.25 or 1.0)
    local rimGrad = create("UIGradient", {
        Rotation = 45,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.30),
            NumberSequenceKeypoint.new(0.35, 0.90),
            NumberSequenceKeypoint.new(0.55, 0.50),
            NumberSequenceKeypoint.new(0.78, 0.90),
            NumberSequenceKeypoint.new(1, 0.30)
        })
    }, outerStroke)

    local bevelRadius = shrinkCornerRadius(radius, 1)
    local bevel = create("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -2, 1, -2), ZIndex = (frame.ZIndex or 1) + 3}, frame)
    local bevelCorner = addCorner(bevel, bevelRadius)
    create("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.76),
            NumberSequenceKeypoint.new(0.5, 0.97),
            NumberSequenceKeypoint.new(1, 0.90)
        })
    }, addStroke(bevel, theme.rim, 0, 1))

    table.insert(widget._reactiveSheens, {host = frame, rimGrad = rimGrad})
    local glass = {mainCorner = mainCorner, bevelCorner = bevelCorner, outerStroke = outerStroke, panelGrad = panelGrad, rimGrad = rimGrad, lensCorners = {}}
    widget._glass[frame] = glass
    return glass
end

