        self._ui.musicRepeatIcon.Image = rep and self.config.repeatOneIcon or self.config.repeatIcon
        self._ui.musicRepeatIcon.ImageColor3 = rep and Color3.fromRGB(255, 255, 255) or theme.textDim
    end
    if self._ui.musicPlayCtrl then self._ui.musicPlayCtrl.setPlaying(self.music.playing == true) end
    if self._ui.musicStatusDot then self._ui.musicStatusDot.BackgroundColor3 = self.music.playing and theme.ok or theme.accent end
