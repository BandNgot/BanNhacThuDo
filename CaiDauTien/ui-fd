local function trimString(v) return tostring(v or ""):gsub("^%s+", ""):gsub("%s+$", "") end

local function shortenText(value, maxChars)
    local text, limit = tostring(value or ""), math.max(1, tonumber(maxChars) or 32)
    local ok, len = pcall(utf8.len, text)
    if ok and len then
        if len <= limit then return text end
        local cut = utf8.offset(text, limit <= 3 and (limit + 1) or (limit - 2))
        if cut then return text:sub(1, cut - 1) .. (limit <= 3 and "" or "...") end
    end
    return (#text <= limit) and text or (text:sub(1, math.max(1, limit - 3)) .. "...")
end

local function extractAssetId(v)
    local t = trimString(v)
    return t ~= "" and (t:match("rbxassetid://(%d+)") or t:match("(%d+)")) or nil
end

local function normalizeSoundId(v)
    local id = extractAssetId(v)
    return id and ("rbxassetid://" .. id) or nil
end

local function urlEncode(v)
    return tostring(v or ""):gsub("([^%w%-_%.~])", function(c) return string.format("%%%02X", string.byte(c)) end)
end

local function formatTime(s)
    local total = math.max(0, math.floor(tonumber(s) or 0))
    return string.format("%d:%02d", math.floor(total / 60), total % 60)
end

local function toIsoTimestamp()
    local ok, dt = pcall(function() return DateTime.now():ToIsoDate() end)
    return (ok and dt) or os.date("!%Y-%m-%dT%H:%M:%SZ")
end

