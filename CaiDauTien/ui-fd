function FeedbackWidget:_refreshMusicTrackUi(track, status, holdSeconds)
    local title, artist = track and track.title or self.config.musicTrackTitle, track and track.artist or self.config.musicTrackSubtitle
    if self._ui.musicTitle then self._ui.musicTitle.Text = shortenText(title, 15) end
    if self._ui.musicTrackTitle then self._ui.musicTrackTitle.Text = shortenText(title, 34) end
    if self._ui.musicTrackSubtitle then self._ui.musicTrackSubtitle.Text = shortenText(artist, 30) end
    if self._ui.musicCoverIcon then self._ui.musicCoverIcon.Image = track and track.cover or self.config.musicIcon end
    if self._ui.musicProgressFill then self._ui.musicProgressFill.Size = UDim2.new(0, 0, 1, 0) end
    if self._ui.musicProgressThumb then self._ui.musicProgressThumb.Position = UDim2.new(0, 0, 0.5, 0) end
    if self._ui.musicTimeLeft then self._ui.musicTimeLeft.Text = "0:00" end
    if self._ui.musicTimeRight then self._ui.musicTimeRight.Text = "0:00" end
    self:_setMusicUiStatus(status or (track and "San sang" or "Chua co playlist"), holdSeconds)
    self:_updateMusicActionButtons()
end

function FeedbackWidget:_updateMusicProgress()
    local sound, fill = self.music and self.music.sound, self._ui.musicProgressFill
    if not fill then return end
    local length, pos = sound and tonumber(sound.TimeLength) or 0, sound and tonumber(sound.TimePosition) or 0
    local ratio = length > 0 and math.clamp(pos / length, 0, 1) or 0
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    if self._ui.musicProgressThumb then self._ui.musicProgressThumb.Position = UDim2.new(ratio, 0, 0.5, 0) end
    if self._ui.musicTimeLeft then self._ui.musicTimeLeft.Text = formatTime(pos) end
    if self._ui.musicTimeRight then self._ui.musicTimeRight.Text = length > 0 and formatTime(length) or "0:00" end
    if self.music.playing and os.clock() >= (self._musicStatusHoldUntil or 0) then
        self:_setMusicUiStatus(length > 0 and (formatTime(pos) .. " / " .. formatTime(length)) or "Dang tai...")
    end
end

function FeedbackWidget:_seekMusicAtScreenX(screenX)
    local bar, sound = self._ui.musicProgressTrack, self.music and self.music.sound
    if not bar or not sound or bar.AbsoluteSize.X <= 0 then return end
    local length = tonumber(sound.TimeLength) or 0
    if length <= 0 then return end
    local ratio = math.clamp((screenX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
    local newPos = ratio * length
    pcall(function() sound.TimePosition = newPos end)
    if self._ui.musicProgressFill then self._ui.musicProgressFill.Size = UDim2.new(ratio, 0, 1, 0) end
    if self._ui.musicProgressThumb then self._ui.musicProgressThumb.Position = UDim2.new(ratio, 0, 0.5, 0) end
    if self._ui.musicTimeLeft then self._ui.musicTimeLeft.Text = formatTime(newPos) end
    self:_setMusicUiStatus(formatTime(newPos) .. " / " .. formatTime(length), 0.9)
end

function FeedbackWidget:_setMusicVolume(ratio, unmute)
    local vol = math.clamp(tonumber(ratio) or 0, 0, 1)
    self.music.volume = vol
    if unmute ~= false and vol > 0 then self.music.muted = false elseif vol <= 0 then self.music.muted = true end
    self:_applySoundVolume()
end

function FeedbackWidget:_toggleMusicMute() self.music.muted = not self.music.muted; self:_applySoundVolume() end

function FeedbackWidget:_applySoundVolume()
    local eff = self.music.muted and 0 or self.music.volume
    if self.music.sound then pcall(function() self.music.sound.Volume = eff end) end
    if self._ui.volumeFill then self._ui.volumeFill.Size = UDim2.new(eff, 0, 1, 0) end
    if self._ui.volumeText then self._ui.volumeText.Text = string.format("%d%%", math.floor(eff * 100 + 0.5)) end
    if self._ui.volumeIconCtrl then self._ui.volumeIconCtrl.setMuted(self.music.muted or eff <= 0.001) end
end

function FeedbackWidget:_watchAudioPlayback(sound, loadToken)
    task.spawn(function()
        local deadline = os.clock() + 4.5
        while os.clock() < deadline do
            if loadToken ~= self._musicLoadToken or not self.state.mounted or not self.music.playing then return end
            local ok, loaded, length = pcall(function() return sound.IsLoaded, tonumber(sound.TimeLength) or 0 end)
            if ok and (loaded or length > 0) then return end
            task.wait(0.25)
        end
        if loadToken ~= self._musicLoadToken or not self.state.mounted or not self.music.playing then return end
        local ok, loaded, length = pcall(function() return sound.IsLoaded, tonumber(sound.TimeLength) or 0 end)
        if not ok or (not loaded and length <= 0) then
            self.music.playing, self.music.paused = false, false
            pcall(function() sound:Stop() end)
            self:_setMusicUiStatus("Audio loi hoac bi khoa", 2.5); self:_updateMusicActionButtons()
        end
    end)
end

function FeedbackWidget:_loadMusicTrack(index, autoplay)
    self._musicLoadToken = (self._musicLoadToken or 0) + 1
    local loadToken, playlist = self._musicLoadToken, self.music.playlist or {}
    if type(playlist) ~= "table" or #playlist == 0 then
        self.music.playing, self.music.paused, self.music.loadedSoundId = false, false, nil
        self:_refreshMusicTrackUi(nil, "Chua co playlist"); return false
    end
    index = tonumber(index) or 1
    if index < 1 then index = #playlist elseif index > #playlist then index = 1 end
    local track = self:_getMusicTrack(index)
    if not track or not track.soundId then
        self.music.playing, self.music.paused = false, false; self:_refreshMusicTrackUi(track, "Track loi SoundId"); return false
    end
    local sound = self:_ensureMusicSound()
    self.music.index, self.music.loadedSoundId, self.music.playing, self.music.paused = index, track.soundId, false, false
    pcall(function() sound:Stop(); sound.SoundId = track.soundId; sound.TimePosition = 0; sound.Volume = self.music.muted and 0 or self.music.volume end)
    self:_refreshMusicTrackUi(track, autoplay and "Dang tai..." or "San sang")
    if autoplay then
        local ok = pcall(function() sound:Play() end)
        self.music.playing = ok
        self:_setMusicUiStatus(ok and "Dang phat" or "Khong phat duoc"); self:_updateMusicActionButtons()
        if ok then self:_watchAudioPlayback(sound, loadToken) end
        return ok
    end
    return true
end

function FeedbackWidget:_playMusic()
    local track = self:_getMusicTrack(self.music.index or 1)
    if not track then self:_refreshMusicTrackUi(nil, "Them musicPlaylist truoc") return end
    if self.music.loadedSoundId ~= track.soundId then self:_loadMusicTrack(self.music.index or 1, true) return end
    local sound, wasPaused = self:_ensureMusicSound(), self.music.paused == true
    local ok = pcall(function() if wasPaused then sound:Resume() else sound:Play() end end)
    if not ok and wasPaused then ok = pcall(function() sound:Play() end) end
    self.music.playing, self.music.paused = ok, false
    self._musicLoadToken = (self._musicLoadToken or 0) + 1
    self:_setMusicUiStatus(ok and "Dang phat" or "Khong phat duoc"); self:_updateMusicActionButtons()
    if ok then self:_watchAudioPlayback(sound, self._musicLoadToken) end
end

function FeedbackWidget:_pauseMusic()
    if self.music.sound then pcall(function() self.music.sound:Pause() end) end
    self.music.playing, self.music.paused = false, true
    self._musicLoadToken = (self._musicLoadToken or 0) + 1
    self:_setMusicUiStatus("Tam dung", 1.5); self:_updateMusicProgress(); self:_updateMusicActionButtons()
end

function FeedbackWidget:_toggleMusicPlayback() if self.music.playing then self:_pauseMusic() else self:_playMusic() end end
function FeedbackWidget:_nextMusicTrack(force) if #(self.music.playlist or {}) == 0 then self:_refreshMusicTrackUi(nil, "Chua co playlist") return end; self:_loadMusicTrack((self.music.index or 1) + 1, force == true or self.music.playing) end
function FeedbackWidget:_prevMusicTrack() if #(self.music.playlist or {}) == 0 then self:_refreshMusicTrackUi(nil, "Chua co playlist") return end; self:_loadMusicTrack((self.music.index or 1) - 1, self.music.playing) end

function FeedbackWidget:_copyCurrentMusicAssetId()
    local track = self:_getMusicTrack(self.music.index or 1)
    if not track or not track.soundId then self:_setMusicUiStatus("Chua co assetId", 2) return end
    local id = extractAssetId(track.soundId)
    local val = id and ("rbxassetid://" .. id) or tostring(track.soundId)
    if copyToClipboard(val) then self:_setMusicUiStatus("Da copy " .. val, 2); self:_showToast("Da copy " .. val, "ok")
    else self:_setMusicUiStatus("Clipboard khong ho tro", 2) end
end

function FeedbackWidget:_toggleMusicRepeat()
    self.music.repeatOne = not self.music.repeatOne
    self:_setMusicUiStatus(self.music.repeatOne and "Lap lai 1 bai: bat" or "Lap lai 1 bai: tat", 2)
    self:_updateMusicActionButtons()
end

function FeedbackWidget:_toggleCurrentMusicFavorite()
    self:_syncMusicFavoriteMap()
    local track = self:_getMusicTrack(self.music.index or 1)
    local key = self:_musicTrackKey(track)
    if not track or not key then self:_setMusicUiStatus("Chua co bai de luu", 2) return end

    local removed = false
    if self.music.favoriteMap[key] then
        removed = true
        for i = #self.music.favorites, 1, -1 do if self:_musicTrackKey(self.music.favorites[i]) == key then table.remove(self.music.favorites, i) end end
        self.music.favoriteMap[key] = nil
        self:_setMusicUiStatus(self:_saveMusicStorage() and "Da bo tim + luu file" or "Da bo tim runtime", 2)
    else
        table.insert(self.music.favorites, track); self.music.favoriteMap[key] = true
        self:_setMusicUiStatus(self:_saveMusicStorage() and ("Da luu vao " .. tostring(self.config.musicStorageFile)) or "Da luu runtime", 2)
    end

    if removed and self.music.queueSource == "favorites" then
        local newQ = {}
        for i, item in ipairs(self.music.favorites) do local t = self:_normalizeMusicItem(item, i); if t then table.insert(newQ, t) end end
        self.music.playlist = newQ
        if #newQ == 0 then
            self.music.index, self.music.playing, self.music.paused, self.music.loadedSoundId = 1, false, false, nil
            if self.music.sound then pcall(function() self.music.sound:Stop() end) end
            self:_refreshMusicTrackUi(nil, "Danh sach Saved trong", 2)
        else self.music.index = math.clamp(self.music.index or 1, 1, #newQ) end
    end
    self:_updateMusicActionButtons(); self:_updateMusicViewTabs(true)
    if self.music.viewMode == "favorites" or self.music.viewMode == "playlist" then self:_renderMusicCollection(self.music.viewMode, nil, true) end
end

function FeedbackWidget:SetMusicPlaylist(playlist, startIndex)
    self.music = self.music or {}
    local copied = {}
    if type(playlist) == "table" then for _, item in ipairs(playlist) do table.insert(copied, item) end end
    self.music.masterPlaylist, self.music.playlist = copied, copied
    self.music.index, self.music.loadedSoundId, self.music.playing, self.music.paused, self.music.queueSource = tonumber(startIndex) or 1, nil, false, false, "playlist"
    if self.music.sound then pcall(function() self.music.sound:Stop(); self.music.sound.SoundId = "" end) end
    self:_loadMusicTrack(self.music.index, false); self:_updateMusicViewTabs(true)
    if self.music.viewMode == "playlist" then self:_renderMusicCollection("playlist", nil, true) end
end

function FeedbackWidget:_createMusicResultRow(index)
    local theme = self.theme
    local row = create("TextButton", {Name = "TrackRow_" .. tostring(index), BackgroundColor3 = theme.cardBg, BackgroundTransparency = theme.cardTransparency, Size = UDim2.new(1, 0, 0, 44), AutoButtonColor = false, Text = "", Visible = false, ZIndex = 15}, self._ui.musicResultsScroll)
    addCorner(row, 14)
    local rowStroke = addStroke(row, theme.rim, 0.78, 1)
    local idxLbl = makeLabel(row, tostring(index), FONT_MONO, 11, theme.textMuted, UDim2.fromOffset(10, 0), UDim2.new(0, 22, 1, 0), 16, Enum.TextXAlignment.Center)
    local titleLbl = makeLabel(row, "", FONT_MEDIUM, 12, theme.text, UDim2.fromOffset(36, 5), UDim2.new(1, -68, 0, 18), 16)
    local artistLbl = makeLabel(row, "", FONT_BODY, 11, theme.textMuted, UDim2.fromOffset(36, 23), UDim2.new(1, -68, 0, 15), 16)
    local favBadge = create("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(14, 14), Image = self.config.favoriteIcon, ImageColor3 = theme.heart, Visible = false, ZIndex = 16}, row)

    self:_trackConnection(row.MouseEnter:Connect(function() row.BackgroundColor3, row.BackgroundTransparency, rowStroke.Transparency = theme.cardHover, theme.cardHoverTransparency, 0.56 end))
    self:_trackConnection(row.MouseLeave:Connect(function() row.BackgroundColor3, row.BackgroundTransparency, rowStroke.Transparency = theme.cardBg, theme.cardTransparency, 0.78 end))
    self:_trackConnection(row.MouseButton1Click:Connect(function() self:_selectMusicResult(index) end))
    return {button = row, index = idxLbl, title = titleLbl, artist = artistLbl, fav = favBadge}
end

function FeedbackWidget:_renderMusicList(results)
    if not self._ui.musicResultsScroll then return end
    results = type(results) == "table" and results or {}
    self.music.searchResults, self._ui.musicResultRows = results, self._ui.musicResultRows or {}
    local rows = self._ui.musicResultRows
    for i = 1, #results do
        if not rows[i] then rows[i] = self:_createMusicResultRow(i) end
        local row, item = rows[i], self:_normalizeMusicItem(results[i], i)
        if item then
            row.index.Text, row.title.Text, row.artist.Text = string.format("%02d", i), shortenText(item.title, 34), shortenText(item.artist, 30)
            row.fav.Visible, row.button.Visible = self:_isMusicFavorite(item), true
        else row.button.Visible = false end
    end
