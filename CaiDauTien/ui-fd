local function readJsonFile(path)
    if type(readfile) ~= "function" then return nil, "readfile missing" end
    if type(isfile) == "function" then
        local ok, exists = pcall(isfile, path)
        if ok and not exists then return nil, "file missing" end
    end
    local ok, content = pcall(readfile, path)
    if not ok or type(content) ~= "string" or content == "" then return nil, tostring(content or "empty file") end
    local decOk, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not decOk or type(decoded) ~= "table" then return nil, "json decode failed" end
    return decoded, nil
end

local function writeJsonFile(path, data)
    if type(writefile) ~= "function" then return false, "writefile missing" end
    local encOk, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not encOk then return false, tostring(encoded) end
    local wOk, err = pcall(writefile, path, encoded)
    return wOk, wOk and nil or tostring(err)
end

local function getExecutorName()
    for _, fn in ipairs({identifyexecutor, getexecutorname, get_executor_name}) do
        if type(fn) == "function" then
            local ok, v = pcall(fn)
            if ok and v then return tostring(v) end
        end
    end
    return "unknown"
end

-- Discord Webhook Client -----------------------------------------------------

local WebhookClient = {}
WebhookClient.__index = WebhookClient
function WebhookClient.new(url) return setmetatable({url = url}, WebhookClient) end

function WebhookClient:send(payload)
    if type(self.url) ~= "string" or not self.url:match("^https?://") then
        return {ok = false, statusCode = 0, error = "Invalid webhook URL"}
    end
    local req = getRequestFn()
    if not req then
        return {ok = false, statusCode = 0, error = "No supported request function (syn.request/http.request/request)"}
    end
    local encOk, body = pcall(function() return HttpService:JSONEncode(payload) end)
    if not encOk then return {ok = false, statusCode = 0, error = "JSON encode failed: " .. tostring(body)} end

    local ok, response = pcall(req, {Url = self.url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
    if not ok then return {ok = false, statusCode = 0, error = tostring(response)} end
    if type(response) ~= "table" then return {ok = false, statusCode = 0, error = "Invalid HTTP response"} end

    local status = tonumber(response.StatusCode or response.Status or response.statusCode or response.status or 0) or 0
    local success = response.Success
    if success == nil then success = response.success end
    if success == nil then success = (status >= 200 and status < 300) end
    local respBody, statusMsg = response.Body ~= nil and response.Body or response.body, response.StatusMessage or response.statusMessage
    local errMsg
    if success ~= true then
        if type(respBody) == "string" and trimString(respBody) ~= "" then errMsg = shortenText(trimString(respBody), 140)
        elseif type(statusMsg) == "string" and trimString(statusMsg) ~= "" then errMsg = statusMsg
        else errMsg = status > 0 and ("HTTP " .. tostring(status)) or "Request failed" end
    end
    return {ok = success == true, statusCode = status, error = errMsg}
end

